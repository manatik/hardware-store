{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "redux": ["node_modules/redux"],
      "@features": ["features"],
      "@features/*": ["features/*"],
      "@pages/*": ["pages/*"],
      "@utils": ["utils"],
      "@utils/*": ["utils/*"],
      "@models": ["models"],
      "@models/*": ["models/*"],
      "@helpers": ["helpers"],
      "@hooks": ["hooks"],
      "@api": ["api"],
      "@api/*": ["api/*"],
      "@schema": ["schema"],
      "@schema/*": ["schema/*"],
      "@public": ["public"],
      "@public/*": ["public/*"],
      "@store": ["store"],
      "@store/*": ["store/*"],
      "@services/*": ["services/*"],
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
