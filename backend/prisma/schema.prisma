// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
	id                  Int         @id @default(autoincrement())
	name                String      @unique
	article             String      @unique
	plywoodProducts     Plywood[]
	furnitureProducts   Furniture[]
	houseProducts       House[]
	createdAt           DateTime    @map("created_at") @default(now())
  updatedAt           DateTime?   @map("updated_at")
  deleted             DateTime?

  @@map("category")
}

/////////////////////////////////////////////////////////////
//////////////////  USER  //////////////////////////////////
///////////////////////////////////////////////////////////

model User {
	id            Int         @id @default(autoincrement())
	email         String      @unique
	password      String
	tokens        UserToken[]
	roles         Role[]
	createdAt     DateTime    @default(now()) @map("created_at")
	updatedAt     DateTime?   @map("updated_at")
	deleted       DateTime?

    @@map("user")
}

model UserToken {
	id            Int         @id @default(autoincrement())
	user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
	userId        Int         @map("user_id")
	token         String      @unique
	expireIn      DateTime    @map("expire_in")
	createdAt     DateTime    @default(now()) @map("created_at")

    @@map("user_token")
}

model Role {
	id          Int         @id @default(autoincrement())
	name        String      @unique
	users       User[]
	createdAt   DateTime    @default(now()) @map("created_at")
	updatedAt   DateTime?   @map("updated_at")

	@@map("role")
}

/////////////////////////////////////////////////////////////
//////////////////  PLYWOOD  ///////////////////////////////
///////////////////////////////////////////////////////////

model Plywood {
	id                  Int                       @id @default(autoincrement())
	name                String
	article             String                    @unique
	photos              Json?
	category            Category                  @relation(fields: [categoryId], references: [id])
	categoryId          Int                       @map("category_id")
	formats             PlywoodFormat[]
	surfaceTypes        PlywoodSurfaceType[]
	types               PlywoodType[]
	sorts               PlywoodSort[]
	coatingDensity      PlywoodCoatingDensity[]
	width               Int
	available           Boolean
	price               Int
	createdAt           DateTime                  @map("created_at") @default(now())
  updatedAt           DateTime?                 @map("updated_at")
  deleted             DateTime?

  @@map("plywood")
}

model PlywoodFormat {
  id              Int         @id @default(autoincrement())
  plywoods        Plywood[]
  name            String
  size            String      @unique
  price           Int
  createdAt       DateTime    @map("created_at") @default(now())
  updatedAt       DateTime?   @map("updated_at")

  @@map("plywood_format")
}

model PlywoodSurfaceType {
  id          Int       @id @default(autoincrement())
  plywood     Plywood[]
  name        String    @unique
  price       Int
  createdAt   DateTime  @map("created_at") @default(now())
  updatedAt   DateTime? @map("updated_at")

  @@map("plywood_surface_type")
}

model PlywoodType {
	id          Int         @id @default(autoincrement())
	plywood     Plywood[]
	name        String      @unique
	price       Int
	updatedAt   DateTime? @map("updated_at")

  @@map("plywood_type")
}

model PlywoodSort {
	id          Int         @id @default(autoincrement())
  plywood     Plywood[]
  name        String
  price       Int
  updatedAt   DateTime?   @map("updated_at")

  @@map("plywood_sort")
}

model PlywoodCoatingDensity {
	id          Int         @id @default(autoincrement())
  plywood     Plywood[]
  name        String
  price       Int
  updatedAt   DateTime?   @map("updated_at")

  @@map("plywood_coating_density")
}

/////////////////////////////////////////////////////////////
//////////////////  FURNITURE  /////////////////////////////
///////////////////////////////////////////////////////////

model Furniture {
  id          Int             @id @default(autoincrement())
  name        String
  article     String          @unique
  photos      Json?
  category    Category        @relation(fields: [categoryId], references: [id])
  categoryId  Int             @map("category_id")
  createdAt   DateTime        @map("created_at") @default(now())
  updatedAt   DateTime?       @map("updated_at")
  deleted     DateTime?

  @@map("furniture")
}

/////////////////////////////////////////////////////////////
//////////////////  HOUSE  /////////////////////////////////
///////////////////////////////////////////////////////////

model House {
  id          Int             @id @default(autoincrement())
  name        String
  article     String          @unique
  photos      Json?
  category    Category        @relation(fields: [categoryId], references: [id])
  categoryId  Int             @map("category_id")
  createdAt   DateTime        @map("created_at") @default(now())
  updatedAt   DateTime?       @map("updated_at")
  deleted     DateTime?

  @@map("house")
}